MAC_HOST=192.168.178.58
MAC_AGENT_PORT=8010
MAC_WHISPER_PORT=8001
MAC_AGENT_TOKEN=CHANGE_ME

SERVER_WHISPER_URL=http://whisper:8000
MAC_WHISPER_MODEL=whisper-large-v3-turbo
SERVER_WHISPER_MODEL=Systran/faster-whisper-medium
WHISPER_IDLE_SECONDS=600

LITELLM_URL=http://litellm:4000
LITELLM_API_KEY=CHANGE_ME

DATABASE_PATH=/app/data/queue.db
TASK_WORKER_POLL_SECONDS=5

MAC_MEMORY_LIMIT_PERCENT=80
ALLOW_SIMULTANEOUS_MAC_AI=false

AUDIO_ROOT=/remote/Audio
WHISPER_WORKER_POLL_SECONDS=5
AUDIO_WATCHER_POLL_SECONDS=5
AUDIO_FILE_SETTLE_SECONDS=10

QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=homelab_knowledge
EMBEDDING_MODEL=nomic-embed
KNOWLEDGE_CHUNK_SIZE=1200
KNOWLEDGE_CHUNK_OVERLAP=200
